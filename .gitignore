# RAG legacy benchmark corpus (now unified under corpus/)
benchmark/qa/corpus/
benchmark/qa/sources/

# LaTeX build intermediates (paper compiles with tectonic; keep only paper.pdf)
writing/paper/*.aux
writing/paper/*.bbl
writing/paper/*.out
writing/paper/*.log
writing/paper/*.blg

# OpenTelemetry traces
*.otlp
traces/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
node_modules/

# Scratch / tooling output (not for commit)
tmp/
.playwright-mcp/
