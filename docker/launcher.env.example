# MatClaw launcher configuration (host-side; NOT mounted into the container).
#
# Sourced by BOTH docker/host_up.sh and docker/run.sh. Plain KEY=value lines.
# These scripts run on the host, before the container exists, so this file is
# never mounted -- only the agent's runtime config (configs/llm_config.yaml etc.)
# crosses into the container.
#
# Setup:
#   cp docker/launcher.env.example ~/.config/matclaw/launcher.env
#   chmod 600 ~/.config/matclaw/launcher.env
#   $EDITOR ~/.config/matclaw/launcher.env       # fill in host-specific values
# Relocate it with MATCLAW_LAUNCHER_CONFIG=/path/to/launcher.env.
#
# Resolution order is env > this file > the script's built-in default. The
# ${VAR:-...} idiom below gives that for free: a var exported at invocation
# (e.g. `IMAGE=matclaw:test docker/run.sh ...`) wins; otherwise this file applies;
# otherwise the script's own default does. Keep the idiom when you edit values.
#
# NO SECRETS HERE. SSH host + key come from jobflow-remote (~/.jfremote/<project>.yaml);
# API keys are forwarded from the host shell via the configs' ${VAR} references.

# --- shared (both scripts) ---
IMAGE="${IMAGE:-matclaw:dev}"               # docker image tag (built on first use if missing)

# --- host_up.sh: host services this machine runs ---
MONGO_BIN="${MONGO_BIN:-mongod}"            # mongod on PATH, or an absolute path
MONGO_DBPATH="${MONGO_DBPATH:-$HOME/mongodb/data}"
MONGO_LOG="${MONGO_LOG:-$HOME/mongodb/mongod.log}"
MONGO_PORT="${MONGO_PORT:-27017}"
JF="${JF:-jf}"                              # jobflow-remote CLI on PATH, or an absolute path
JF_PROJECT="${JF_PROJECT:-anvil}"           # jfremote project to bring the runner up for
# DOCKER_BRIDGE_GATEWAY=172.17.0.1          # Linux only: set if auto-detection of the bridge gateway fails
# BREW_MONGO_FORMULA=mongodb-community      # macOS only: brew services formula for mongod (e.g. mongodb-community@7.0)

# --- run.sh: container launch ---
MEM="${MEM:-8g}"
CPUS="${CPUS:-4}"
PIDS="${PIDS:-512}"
MATCLAW_MONGO_HOST="${MATCLAW_MONGO_HOST:-host.docker.internal}"
MATCLAW_WORKSPACE="${MATCLAW_WORKSPACE:-}"  # blank -> repo workspace/; set to keep run data outside the repo
MATCLAW_CONFIGS="${MATCLAW_CONFIGS:-}"      # blank -> repo configs/; set to point at a shared config dir
# MATCLAW_ENV_VOLUME=matclaw-env            # optional named volume -> /home/agent (uv/pip caches persist)
# MATCLAW_FORWARD_ENV="VAR1 VAR2"           # extra env vars to forward beyond the ${VAR}-referenced ones
# DETACH=1 / NAME=... are per-invocation (headless background runs) -- set them on the command line.
